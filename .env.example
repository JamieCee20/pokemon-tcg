# Name of the existing Docker network shared with your Nginx reverse proxy.
DOCKER_NETWORK=proxy

# RapidAPI key for the Pokemon TCG pricing provider. Keep this server-side.
POKEMON_API_KEY=

# Maximum provider lookups per UTC day (cached lookups do not count); use 0 for unlimited.
POKEMON_PRICE_DAILY_LIMIT=90

# APITCG trial API key. Keep this server-side; do not use a VITE_ variable.
APITCG_API_KEY=

# Maximum uncached APITCG calls per UTC day. The catalogue import pauses at
# this cap and resumes after UTC midnight. Set to 0 to remove the local cap.
APITCG_DAILY_REQUEST_LIMIT=2
